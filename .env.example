# 로컬 개발용 예시입니다. 이 파일을 .env로 복사한 뒤 실제 테스트 키를 입력하세요.
# .env는 Git에서 제외되며 애플리케이션이 시작할 때 자동으로 읽습니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin!12345

TOSS_MODE=test
TOSS_CLIENT_KEY=test_ck_replace_with_real_key
TOSS_SECRET_KEY=test_sk_replace_with_real_key
TOSS_CONNECT_TIMEOUT=3s
TOSS_READ_TIMEOUT=10s

APP_PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=./uploads
