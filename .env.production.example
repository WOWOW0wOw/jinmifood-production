# 실제 운영 도메인입니다. Cloudflare Tunnel의 Public Hostname과 일치시킵니다.
DOMAIN=jinmifood.com

# PostgreSQL 설정
POSTGRES_DB=jinmi
POSTGRES_USER=jinmi
POSTGRES_PASSWORD=REPLACE_LOCALLY

# 관리자 계정: 운영 전 반드시 고유한 값으로 변경합니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_LOCALLY

# 최초 배포는 test로 검증하고 운영 심사 후 live로 변경합니다.
TOSS_MODE=test
TOSS_CLIENT_KEY=REPLACE_LOCALLY
TOSS_SECRET_KEY=REPLACE_LOCALLY
TOSS_CONNECT_TIMEOUT=3s
TOSS_READ_TIMEOUT=10s

# SOLAPI 문자인증: 콘솔에서 API 키 발급 및 발신번호 사전등록 후 활성화합니다.
SMS_MODE=solapi
SOLAPI_API_KEY=REPLACE_LOCALLY
SOLAPI_API_SECRET=REPLACE_LOCALLY
SOLAPI_SENDER=REPLACE_LOCALLY

# 소셜 로그인 앱별 Client ID/Secret. 운영 콜백은
# https://jinmifood.com/login/oauth2/code/google|kakao|naver 입니다.
GOOGLE_CLIENT_ID=REPLACE_LOCALLY
GOOGLE_CLIENT_SECRET=REPLACE_LOCALLY
KAKAO_CLIENT_ID=REPLACE_LOCALLY
KAKAO_CLIENT_SECRET=REPLACE_LOCALLY
NAVER_CLIENT_ID=REPLACE_LOCALLY
NAVER_CLIENT_SECRET=REPLACE_LOCALLY

# DB 및 데이터 보존 정책
DB_POOL_SIZE=10
DATA_RETENTION_ENABLED=true
UNPAID_ORDER_TTL=7d
DATA_CLEANUP_BATCH_SIZE=100
DATA_CLEANUP_CRON=0 17 * * * *
DATA_CLEANUP_ZONE=Asia/Seoul
